# sklearn-playground Environment Variables
# Copy this file to .env and fill in your values

# Application
ENVIRONMENT=development
DEBUG=false
LOG_LEVEL=INFO

# PostgreSQL (Azure Database for PostgreSQL Flexible Server)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=skplayground
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_SSL_MODE=require

# Azure Blob Storage
AZURE_STORAGE_ACCOUNT=
AZURE_STORAGE_KEY=
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER_MODELS=models
AZURE_STORAGE_CONTAINER_DATASETS=datasets

# Azure Entra ID (formerly Azure AD) Authentication
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_REDIRECT_URI=http://localhost:8501/auth/callback

# Session
SESSION_SECRET_KEY=change-me-in-production
SESSION_EXPIRY_HOURS=24

# Feature Flags
ENABLE_AUTH=false
ENABLE_EXPERIMENTS=true
ENABLE_MODEL_STORAGE=true
